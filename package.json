{
    "name": "reflect",
    "version": "2.0.0",
    "description": "a mindful website blocker for the productive.",
    "private": true,
    "scripts": {
        "typecheck": "tsc --noEmit",
        "bundle:worker": "esbuild --bundle --minify --keep-names --sourcemap --target=chrome120 src/background.ts --format=esm --alias:onnxruntime-web/webgpu=onnxruntime-web/wasm --outdir=dist/src",
        "bundle:pages": "esbuild --bundle --minify --keep-names --sourcemap --target=chrome120 src/content.ts src/popup.ts src/options.ts --loader:.html=text --loader:.css=text --outdir=dist/src",
        "copy:ort": "mkdir -p dist/ort && cp node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm dist/ort/",
        "bundle": "npm run bundle:worker && npm run bundle:pages && npm run copy:ort",
        "build": "npm run typecheck && npm run bundle",
        "watch": "npm run bundle:pages -- --watch & npm run bundle:worker -- --watch",
        "train:smart-head": "node scripts/train-smart-head.mjs",
        "clean": "rm -rf dist/src dist/ort",
        "test": "esbuild test/*.test.ts --bundle --platform=node --format=esm --outdir=.test-build --out-extension:.js=.mjs --log-level=warning && node --test .test-build/*.test.mjs"
    },
    "devDependencies": {
        "@huggingface/transformers": "4.3.2",
        "@types/chrome": "0.3.7",
        "esbuild": "0.28.2",
        "prettier": "3.9.10",
        "typescript": "7.0.2"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/getreflect/reflect-chrome.git"
    },
    "homepage": "https://github.com/getreflect/reflect-chrome#readme",
    "overrides": {
        "onnxruntime-web": "1.31.1"
    }
}
